# Local development environment (development builds only).
#
# IMPORTANT: this file is NOT a Flutter asset and is NEVER bundled into an
# app artifact. Credential-backed features are disabled when the value is
# empty. Release builds get non-secret toggles via --dart-define build
# flags (see .github/workflows/build.yml).

# Open Food Facts submission credentials (development only).
OFF_USER_ID=
OFF_PASSWORD=
CONTACT_EMAIL=thiago.assisfernandes@gmail.com
USE_OFF_STAGING=false

# User-opt-in Open Prices token (can also be entered in app Settings).
OPEN_PRICES_TOKEN=

# USDA FoodData Central API key (leave empty to disable USDA fallback).
USDA_API_KEY=
