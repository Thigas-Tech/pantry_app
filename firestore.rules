rules_version = '2';

// Security rules for the shared cache collections used by the app.
//
// product_cache and produce_cache are crowd-sourced: any signed-in user may
// write a well-formed document, and every user may read. recipe_cache is
// owner-scoped: documents carry an ingestedBy uid and only that uid may
// update or delete them, so a shared recipe can be removed by its author.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidBarcodeId() {
      return request.resource.id.matches('^[A-Za-z0-9_-]{1,64}$');
    }

    function isValidProduceId() {
      return request.resource.id.matches('^[a-z0-9 _-]{1,128}$');
    }

    function isProductCacheEntry() {
      return request.resource.data is map
        && request.resource.data.barcode is string
        && request.resource.data.barcode.size() > 0
        && request.resource.data.barcode.size() <= 128
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 512
        && request.resource.data.createdAt is int
        && request.resource.data.lastRefreshedAt is int
        && request.resource.data.nextRefreshAt is int;
    }

    function isProduceCacheEntry() {
      return request.resource.data is map
        && request.resource.data.fdcId is int
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 128
        && request.resource.data.createdAt is int
        && request.resource.data.lastRefreshedAt is int
        && request.resource.data.nextRefreshAt is int;
    }

    function isRecipeCacheEntry() {
      return request.resource.data is map
        && request.resource.data.ingestedBy is string
        && request.resource.data.ingestedBy.size() > 0
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 512;
    }

    match /product_cache/{barcode} {
      allow read: if true;
      allow create, update: if isSignedIn()
        && isValidBarcodeId()
        && isProductCacheEntry();
      allow delete: if false;
    }

    match /produce_cache/{name} {
      allow read: if true;
      allow create, update: if isSignedIn()
        && isValidProduceId()
        && isProduceCacheEntry();
      allow delete: if false;
    }

    match /recipe_cache/{recipeId} {
      allow read: if true;
      allow create: if isSignedIn()
        && isRecipeCacheEntry()
        && request.resource.data.ingestedBy == request.auth.uid;
      allow update: if isSignedIn()
        && isRecipeCacheEntry()
        && resource.data.ingestedBy == request.auth.uid
        && request.resource.data.ingestedBy == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.ingestedBy == request.auth.uid;
    }
  }
}
